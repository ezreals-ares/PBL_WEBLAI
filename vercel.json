{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "regions": ["sin1"],
  "trailingSlash": false,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/assets/img/:path*",
      "destination": "https://iuncxpceetiuagqbrcvf.supabase.co/storage/v1/object/public/media/img/:path*"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(config|includes|helpers|vendor|document|api)(/.*)?$", "status": 404 },
    {
      "src": "/(.*)",
      "dest": "/api/index.php",
      "transforms": [
        {
          "type": "request.query",
          "op": "append",
          "target": { "key": "__p" },
          "args": "$1"
        }
      ]
    }
  ]
}
