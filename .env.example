# Database (PostgreSQL / Supabase)
#
# For Supabase, use the connection pooler host from
# Project Settings -> Database -> Connection pooling. The username is
# "postgres.<project-ref>" and the pooler runs in transaction mode (port 6543).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=YOUR_DB_NAME #EXAMPLE = db_lai
DB_USER=postgres
DB_PASS=YOUR_DB_PASSWORD

UPLOAD_DIR=../assets/img/
MAX_FILE_SIZE=2097152

# Media storage (optional)
#
# When these are set, uploads go to a public Supabase Storage bucket through
# the "media-upload" Edge Function, which is required on hosts with a
# read-only filesystem (Vercel). When they are empty, uploads are written to
# assets/img on the local disk instead.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=media
SUPABASE_UPLOAD_TOKEN=YOUR_EDGE_FUNCTION_UPLOAD_TOKEN

SMTP_HOST=smtp.gmail.com
SMTP_USER=your_email@gmail.com
SMTP_PASS=YOUR_APP_PASSWORD
SMTP_PORT=587

MAIL_FROM=admin@example.com
MAIL_FROM_NAME="admin@lab"

MAIL_TO=recipient@example.com
MAIL_TO_NAME="Recipient Name"
